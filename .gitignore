# The release signing key.
#
# A keystore is a private key. It is NOT committed, and the passwords
# for it live in `.env` beside the Maps key. Losing the keystore means
# the app can never be updated in place, so keep a copy somewhere safe
# — but keep it out of the repository.
#
# The `android/` project IS committed, and it holds the release
# signing config — but only the NAMES of the values it reads at build
# time. The passwords are never written into a committed file.
keystores/
*.keystore
!/android/app/debug.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# The Google Maps API key lives in `.env`. It must never be committed.
# `.env.example` IS committed — it is the template, with no key in it.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# Native project
#
# The `android/` project IS committed — it is part of the source, and
# a reviewer needs it to build the app without running `expo prebuild`
# first. What the build PRODUCES is not: the Gradle outputs, the
# caches, and the machine-specific SDK path all stay out.
#
# `ios/` is not committed, because the assignment is Android-only and
# an iOS project generated on one machine is noise in the repository.
/ios

android/app/build/
android/build/
android/.gradle/
android/.cxx/
android/app/.cxx/
android/local.properties

# The Google Maps SDK key.
#
# The key lives in a string resource rather than in the manifest, so
# the committed `AndroidManifest.xml` refers to it by NAME
# (`@string/google_maps_key`) and holds no key. The file that carries
# the value is generated by `expo prebuild` and is not committed.
android/app/src/main/res/values/key.xml

# build artefacts
#
# Nothing that Gradle produces is source. The `android/` folder itself
# is committed (see above), but its build directories, the packaged
# apps and the keystores that sign them are not.
/artifacts
*.apk
*.aab
*.ap_
*.dex

# Local build and bundler logs
*.log
build-*.txt
!/package-lock.json

# A relocated Gradle home, if the build is run with GRADLE_USER_HOME
# pointed inside the project (the Windows build notes explain why).
/.gradle-home

# Figma extraction scratch. The MCP payloads, the zoom crops and the
# screen renders are working files; only the geometry report is kept,
# because every number in src/theme/tokens.ts traces back to it.
.design/*
!.design/figma_report.txt

# The design's screen renders.
#
# `design-reference/screens/01-login.png` … `04-route-view.png` are
# committed: they are the design frames, and they are what the app is
# compared against when a layout question comes up.
#
# The renders with the Figma frame names in them ("Log in.png" and
# friends) are a second, larger export of the same frames. They are
# working files, so they stay out.
design-reference/screens/Log in.png
design-reference/screens/Route view.png
design-reference/screens/Set locations.png
design-reference/screens/Trip ready.png

# Internal working notes.
#
# `md/` holds the assignment's own planning documents (specification,
# tracker, initialization notes). They are kept local for the duration
# of the exercise and are not part of what the hiring team reads.
#
# `README.md` IS committed — it is the handover write-up. This file
# used to hold it back while the write-up was being finished.
md/

